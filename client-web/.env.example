HTTPS=true
SSL_CRT_FILE=./localhost.pem
SSL_KEY_FILE=./localhost-key.pem
REACT_APP_ENV=development

# API prefix – the base URL of the PHP backend (no trailing slash)
# Development (XAMPP local): leave empty to use the CRA proxy, or set to http://localhost/lainaaminen-projekti/server-php
# Production: set to your production API origin, e.g. https://taikukkula.fi/server-php
REACT_APP_API_PREFIX=

# Image/asset prefix – base URL for product/user images served by the PHP backend
# Development: leave empty (served relative to the same origin via proxy)
# Production: e.g. https://taikukkula.fi/server-php/uploads
REACT_APP_IMAGE_PREFIX=